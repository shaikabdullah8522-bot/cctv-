# =============================================================================
# Environment Variables Configuration Template (.env.example)
# AI-Based CCTV Automated Period-Wise Student Attendance System
# =============================================================================



# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Secret key for signing JWT session tokens (HS256)
JWT_SECRET_KEY="cctv_attendance_jwt_secure_secret_key_2026_change_in_production"

# Database path (SQLite)
DATABASE_URL="sqlite:///attendance.db"

# CCTV RTSP stream configuration for live classroom feed
CCTV_RTSP_URL="rtsp://admin:cctv_secure@192.168.1.120:554/live/ch0"

# Gemini AI API Key for server-side attendance copilot and insights
GEMINI_API_KEY=


